# BizMaster AI Agent website — server-side configuration (spec 21).
# Copy to .env.local for development. Never prefix secrets with NEXT_PUBLIC_.

# Production origin. Sets metadataBase/canonicals and is an allowed origin for form posts.
SITE_URL=https://example.com
# Search engines may index the site only when this is "true" (after content approval).
SITE_INDEXING=false
# Show draft plan prices with a "Draft" label in an internal preview build only.
SHOW_DRAFT_PRICES=false

# --- Request storage (demo requests and enquiries) ---------------------------
# Without either option below, forms return an honest "couldn't receive" error and
# nothing is reported as sent.
#
# Option A: forward each request to an HTTPS endpoint you control (CRM, form backend).
# Accepted only on a 2xx response; the submission ID is sent as an Idempotency-Key.
LEAD_STORE_URL=
LEAD_STORE_SECRET=
#
# Option B: store each request as a JSON file. Only for a Node server with a persistent
# disk (not serverless). Ignored when LEAD_STORE_URL is set.
LEAD_STORE_DIR=

# --- Team notifications (Option B only) --------------------------------------
# Each stored request queues a notification delivered to this webhook after the response.
# Failed deliveries retry with backoff and move to <LEAD_STORE_DIR>/dead-letter.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
# Enables POST /api/internal/outbox (Authorization: Bearer <secret>) for a retry cron job.
OUTBOX_PROCESS_SECRET=
